            "output_size": 339,
            "source": [
              {
                "content": "import json\nimport os\n\ndef handler(event, context):\n    print(json.dumps({\n        \"event\": event,\n        \"granules_queue_url\": os.environ.get(\"GRANULES_QUEUE_URL\"),\n        \"table_name\": os.environ.get(\"TABLE_NAME\"),\n        \"cumulus_ingest_queue_url\": os.environ.get(\"CUMULUS_INGEST_QUEUE_URL\"),\n    }))\n\n    return {\n        \"ok\": True\n    }\n",
                "filename": "index.py"
              }
            ],
            "source_content": null,
            "source_content_filename": null,
            "source_dir": null,
            "source_file": null,
            "type": "zip"
          },
          "sensitive_attributes": []
        }
      ]
    },
